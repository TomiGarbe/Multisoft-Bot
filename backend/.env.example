# ============================================================================
# MULTISOFT BOT - Environment Configuration Template
# Copy this to .env and adjust values for your environment
# ============================================================================

# Environment
ENV=development
DEBUG=true

# Application
PROJECT_NAME=Multisoft Bot
VERSION=1.0.0
DESCRIPTION=SaaS platform for conversational bots
API_V1_STR=/api/v1

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=multisoft_bot
DB_USER=postgres
DB_PASSWORD=postgres
# Alternative: Set DATABASE_URL directly instead of components
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/multisoft_bot

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_EXPIRE_MINUTES=1440
SECURITY_BOOTSTRAP_ENABLED=true
INITIAL_BACKDOOR_NAME=Initial Backdoor
INITIAL_BACKDOOR_EMAIL=backdoor@multisoft.local
INITIAL_BACKDOOR_PASSWORD=change-this-password

# CORS Configuration (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Logging
LOG_LEVEL=INFO
