# ============================================================================
# MULTISOFT BOT - Backend LOCAL development environment - TEMPLATE
# ----------------------------------------------------------------------------
# Copy to backend/.env and adjust. ONLY for running the backend outside docker
# (e.g. `uvicorn main:app --reload` directly on your host).
#
# For docker-compose, configure the ROOT .env instead — values are passed to
# the backend container via docker-compose.yml `environment:` block.
# ============================================================================

# ---------- Environment ----------
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ---------- Database (host = localhost when running outside docker) ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=multisoft_bot
DB_USER=postgres
DB_PASSWORD=postgres
# Optional: set DATABASE_URL directly to override the components above.
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/multisoft_bot

# ---------- Security ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-min-32-chars-use-a-real-secret
JWT_EXPIRE_MINUTES=1440
SECURITY_BOOTSTRAP_ENABLED=true
INITIAL_BACKDOOR_NAME=Initial Backdoor
INITIAL_BACKDOOR_EMAIL=backdoor@multisoft.local
INITIAL_BACKDOOR_PASSWORD=change-this-password

# ---------- CORS / Hosts ----------
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------- AI Provider ----------
# DeepSeek is the recommended production default.
# Ollama remains available for manual/local fallback by setting AI_PROVIDER=ollama.
AI_PROVIDER=deepseek
# ---------- Ollama ----------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TOKEN=
OLLAMA_TIMEOUT_SECONDS=300

# ---------- DeepSeek ----------
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_INITIAL_BACKOFF_SECONDS=0.5
DEEPSEEK_MAX_BACKOFF_SECONDS=3
AI_VISION_MAX_IMAGES_PER_REQUEST=3
AI_VISION_MAX_IMAGE_BYTES=3145728
AI_VISION_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
AI_MAX_PROMPT_CHARS=32000
AI_MAX_MULTIMODAL_PAYLOAD_BYTES=5242880

# ---------- WhatsApp (Multisoft Service) ----------
# Optional global fallback. Prefer setting channel.config.webhook_url per channel.
WHATSAPP_MULTISOFT_WEBHOOK_URL=
WHATSAPP_MULTISOFT_TIMEOUT_SECONDS=15
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_ALLOWED_GROUPS=

# Multimedia async download pipeline
ATTACHMENT_DOWNLOAD_TIMEOUT_SECONDS=20
ATTACHMENT_DOWNLOAD_MAX_RETRIES=2
ATTACHMENT_DOWNLOAD_INITIAL_BACKOFF_SECONDS=0.5
ATTACHMENT_DOWNLOAD_MAX_BACKOFF_SECONDS=5
ATTACHMENT_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,audio/mpeg,audio/mp4,audio/ogg,audio/wav,audio/webm,video/mp4,video/webm,video/quicktime,application/pdf,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
ATTACHMENT_MAX_IMAGE_BYTES=10485760
ATTACHMENT_MAX_AUDIO_BYTES=20971520
ATTACHMENT_MAX_VIDEO_BYTES=52428800
ATTACHMENT_MAX_DOCUMENT_BYTES=26214400
PROVIDER_HTTP_MAX_RETRIES=2
PROVIDER_HTTP_INITIAL_BACKOFF_SECONDS=0.4
PROVIDER_HTTP_MAX_BACKOFF_SECONDS=3

# Local Whisper (faster-whisper) baseline configuration
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=
WHISPER_TRANSCRIPTION_TIMEOUT_SECONDS=180
WHISPER_FFMPEG_TIMEOUT_SECONDS=45
