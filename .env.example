# ============================================================================
# MULTISOFT BOT - Docker Compose environment (root) - TEMPLATE
# ----------------------------------------------------------------------------
# Copy this file to `.env` (same directory) and adjust values.
# Docker Compose loads `.env` automatically; ${VAR} references in
# docker-compose.yml are resolved from there.
#
# For non-docker local development of the backend, see backend/.env.example.
# ============================================================================

# ---------- Environment ----------
ENV=production
DEBUG=false
LOG_LEVEL=INFO

# ---------- Database (shared by postgres service AND backend) ----------
# Inside the docker network the host MUST be the service name: `postgres`.
# Never use localhost / 127.0.0.1 here — those refer to the container itself.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=multisoft_bot
DB_USER=postgres
DB_PASSWORD=change-me

# ---------- Security ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-min-32-chars-use-a-real-secret
JWT_EXPIRE_MINUTES=1440
SECURITY_BOOTSTRAP_ENABLED=true
INITIAL_BACKDOOR_NAME=Admin
INITIAL_BACKDOOR_EMAIL=admin@multisoft.local
INITIAL_BACKDOOR_PASSWORD=change-me

# ---------- CORS / Hosts (backend) ----------
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------- Ollama ----------
OLLAMA_BASE_URL=https://ollama.multisoft.ar
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TOKEN=

# ---------- WhatsApp (Multisoft Service) ----------
# Optional global fallback. Prefer setting channel.config.webhook_url per channel.
WHATSAPP_MULTISOFT_WEBHOOK_URL=
WHATSAPP_MULTISOFT_TIMEOUT_SECONDS=15

# ---------- Frontend ----------
# NEXT_PUBLIC_* is baked into the browser bundle at build time; the browser
# runs on the host, so use a host-reachable URL (the backend's published port).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
